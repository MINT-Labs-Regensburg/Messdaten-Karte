# Kopie nach .env (wird nicht eingecheckt). Für `docker compose`.

# Datenbank. Das Passwort URL-sicher wählen (nur Buchstaben/Ziffern), z. B.: openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_DB=messdaten
# POSTGRES_USER=messdaten

# Mindestens 32 Zeichen, z. B.: openssl rand -base64 48
SECRET_KEY=

# Erster Admin (wird beim Start angelegt, falls er noch nicht existiert)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Secure-Cookies: hinter HTTPS (Reverse Proxy) true lassen; nur für lokale HTTP-Tests false
# COOKIE_SECURE=true

# Frontend-Port auf dem Host (127.0.0.1 = nur lokal, der Reverse Proxy leitet weiter)
# HTTP_BIND=127.0.0.1
# HTTP_PORT=8080
# BACKEND_PORT=8000

# Weitere erlaubte Origins für WebSockets (JSON-Liste), meist nicht nötig
# ALLOWED_ORIGINS=["https://karte.example.org"]

# Limits
# MAX_RADIUS_M=5000
# MAX_MEASUREMENTS_PER_PROJECT=5000
